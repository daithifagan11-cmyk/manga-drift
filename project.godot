[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/ssao/quality=4
environment/ssao/half_size=false
scaling_3d/mode=0
scaling_3d/scale=0.75
textures/canvas_textures/default_texture_filter=0
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
environment/volumetric_fog/use_filter=true
environment/defaults/default_clear_color=Color(0.07, 0.13, 0.26, 1)
environment/ssr/max_steps=128
environment/ssr/half_size=false
scaling_3d/fsr2_sharpness=0.8
